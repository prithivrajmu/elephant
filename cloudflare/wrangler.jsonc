{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elephant-memory-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ratelimits": [{
    "name": "RATE_LIMITER",
    // Example namespace only: operators must choose an unused numeric ID in their account.
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "durable_objects": {
    "bindings": [{ "name": "MEMORY", "class_name": "PersonalMemory" }, { "name": "TEAM", "class_name": "TeamMemory" }, { "name": "EVIDENCE", "class_name": "EvidenceConnector" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalMemory"] }, { "tag": "v2", "new_sqlite_classes": ["TeamMemory"] }, { "tag": "v3", "new_sqlite_classes": ["EvidenceConnector"] }],
  "observability": { "enabled": false }
}
