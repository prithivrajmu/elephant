{
  "name": "@elephant/cloudflare-pilot",
  "version": "0.1.0",
  "description": "Optional authenticated Elephant MCP service on Cloudflare",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:auth": "node scripts/dev-auth.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "wrangler deploy"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.26.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "private": true
}
